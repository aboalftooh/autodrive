{
  "contractVersion": 1,
  "defaultFullWipe": false,
  "hashAlgorithm": "SHA-256",
  "localOnlyFieldsExcluded": [
    "syncStatus",
    "readSynced",
    "pendingWithdrawal",
    "retry timestamps",
    "leaseUntil",
    "local_path",
    "diagnostic timestamps",
    "chat_recovery_seq"
  ],
  "manifestRpc": "autodrive_sync_manifest_v1",
  "partitionDigest": "SHA-256(sorted entityId\\tdigest\\n)",
  "partitionRpc": "autodrive_sync_partition_v1",
  "partitionScheme": "first 2 hex chars of SHA-256(entityId)",
  "pendingLocalPolicy": "defer whole reconciliation while scoped Outbox has active intent; appliers also protect entity-local pending state",
  "persistentMismatch": "REBOOTSTRAP_REQUIRED",
  "rowEncoding": "ordered allowlisted fields; null=-1:, non-null=<utf8-byte-length>:<value>",
  "runtimeVerified": false,
  "session": 72,
  "targetedRepair": true
}
